# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. Used solely by the /r/[code] redirect route. NEVER prefix with
# NEXT_PUBLIC_ and never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Render render service (no trailing slash) ---
NEXT_PUBLIC_RENDER_API_URL=https://nanocer-render.onrender.com

# --- This app's own public base URL (encoded into dynamic QR codes) ---
# Local dev: http://localhost:3000 ; production: your Vercel URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Lead notifications (Resend) ---
# Server-only. When set, the owner is emailed the moment a lead is captured.
# RESEND_FROM must be a verified sender (verify the domain's DNS in Resend first).
# Leave unset to disable email notifications (lead capture still works).
RESEND_API_KEY=
RESEND_FROM=Nanocer <leads@yourdomain.com>

# --- Image optimization (Supabase Storage transforms) ---
# Set to 1 to serve resized/compressed images via Supabase's render/image
# endpoint (requires the Supabase Pro plan). Unset/0 = serve raw URLs (default).
NEXT_PUBLIC_IMG_TRANSFORM=

# --- Lead escalation sweep (cron) ---
# Server-only shared secret guarding POST/GET /api/escalate. The scheduler
# (Supabase pg_cron + pg_net, or Vercel Cron) must send it as
# `Authorization: Bearer <CRON_SECRET>`. See supabase/migrations/0013_teams.sql.
CRON_SECRET=
